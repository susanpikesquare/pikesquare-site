---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../lib/site';

const inputClass =
  'mt-2 w-full rounded-lg border border-ink/20 bg-white px-4 py-3 text-ink shadow-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/30';
---

<BaseLayout title="Contact us — PikeSquare">
  <!-- Hero + form -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-2xl px-6 pb-16 pt-20">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-accent">Contact us</p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-deep md:text-5xl">
          Let's talk.
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-muted">
          Tell us who you are and what you need. We read every message and will get back to you.
        </p>
      </div>

      <form id="contact-form" class="mt-10 space-y-6" novalidate>
        <div>
          <label for="name" class="block text-sm font-semibold text-ink">
            Name <span class="text-accent">*</span>
          </label>
          <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} />
        </div>

        <div>
          <label for="company" class="block text-sm font-semibold text-ink">Company</label>
          <input id="company" name="company" type="text" autocomplete="organization" class={inputClass} />
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="email" class="block text-sm font-semibold text-ink">
              Email <span class="text-accent">*</span>
            </label>
            <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
          </div>
          <div>
            <label for="phone" class="block text-sm font-semibold text-ink">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" class={inputClass} />
          </div>
        </div>

        <div>
          <label for="need" class="block text-sm font-semibold text-ink">
            What do you need help with? <span class="text-accent">*</span>
          </label>
          <textarea id="need" name="need" rows="5" required class={inputClass}></textarea>
        </div>

        <!-- Honeypot: hidden from people, catches bots -->
        <div class="hidden" aria-hidden="true">
          <label>Leave this field empty
            <input name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
          <button
            type="submit"
            id="contact-submit"
            class="inline-flex items-center justify-center rounded-full bg-deep px-7 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-accent disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send message
          </button>
          <p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
        </div>

        <noscript>
          <p class="text-sm text-muted">
            This form needs JavaScript enabled. You can also email us at
            <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-deep underline">{CONTACT_EMAIL}</a>.
          </p>
        </noscript>
      </form>

      <p class="mt-6 text-center text-sm text-muted">
        Prefer email? Reach us at
        <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-deep underline-offset-4 hover:underline">{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>

  <!-- What to expect -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">What to expect</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-deep">
        A useful conversation — even if we don't end up working together.
      </h2>
      <ul class="mt-8 space-y-5">
        <li class="flex gap-4">
          <span aria-hidden="true" class="mt-2 inline-block h-2.5 w-2.5 flex-none bg-accent"></span>
          <div>
            <p class="font-semibold text-ink">You talk first.</p>
            <p class="mt-1 text-muted">Walk us through the moment — the deal, the team, the quarter, the board ask. We'll listen and ask sharp questions.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span aria-hidden="true" class="mt-2 inline-block h-2.5 w-2.5 flex-none bg-accent"></span>
          <div>
            <p class="font-semibold text-ink">We tell you what we'd actually do.</p>
            <p class="mt-1 text-muted">Where we'd start, what shape of engagement fits, and a rough sense of cost and timing.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span aria-hidden="true" class="mt-2 inline-block h-2.5 w-2.5 flex-none bg-accent"></span>
          <div>
            <p class="font-semibold text-ink">If we're not the fit, we'll tell you.</p>
            <p class="mt-1 text-muted">And where possible, point you at the operator, advisor, or firm who is. We'd rather lose a deal than ship one that won't work.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-status');
    const submit = document.getElementById('contact-submit');

    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = '';
        status.className = 'text-sm';

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const payload = Object.fromEntries(new FormData(form).entries());
        const originalLabel = submit.textContent;
        submit.disabled = true;
        submit.textContent = 'Sending…';

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const body = await res.json().catch(() => ({}));

          if (res.ok && body.ok) {
            form.reset();
            status.textContent = "Thanks — your message is on its way. We'll be in touch soon.";
            status.className = 'text-sm font-semibold text-deep';
          } else {
            status.textContent =
              body.error || 'Something went wrong. Please try again or email us directly.';
            status.className = 'text-sm font-semibold text-rust';
          }
        } catch {
          status.textContent = 'Something went wrong. Please try again or email us directly.';
          status.className = 'text-sm font-semibold text-rust';
        } finally {
          submit.disabled = false;
          submit.textContent = originalLabel;
        }
      });
    }
  </script>
</BaseLayout>
