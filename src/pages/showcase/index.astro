---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';

// Custom apps PikeSquare has built — examples, not products you have to use.
// They illustrate what we can build with you, for you, or alongside your team.
type App = {
  name: string;
  tagline: string;
  blurb: string;
  bullets: string[];
  url: string;
  label: string;
  image?: string;            // single hero image
  gallery?: { src: string; caption: string }[]; // multi-image carousel
};

const apps: App[] = [
  {
    name: 'PrismIQ',
    tagline: 'Build business cases in seconds, not hours.',
    blurb: "An app concept for helping sales and customer success teams quantify, visualize, and communicate measurable business impact — from the first pitch to every renewal. Replaces bespoke ROI spreadsheets with an AI-powered tool reps can actually use mid-cycle.",
    bullets: [
      'Build business cases in minutes instead of hours',
      'AI-powered automation behind the math',
      'Designed for every stage of the customer journey',
    ],
    url: 'https://calculator.pikesquare.co/',
    label: 'Example app — from our practice',
    gallery: [
      { src: '/showcase/prismiq-research.png',      caption: 'AI Company Research — pulls industry, headcount, tech stack, and the compliance gap that makes the deal in seconds.' },
      { src: '/showcase/prismiq-metrics.png',       caption: 'Industry-validated benchmarks turn ROI inputs into a defensible $4.2M annual value — no spreadsheet required.' },
      { src: '/showcase/prismiq-business-case.png', caption: 'A CFO-grade business case the rep can send, track, and follow up on — with engagement insight by stakeholder.' },
    ],
  },
  {
    name: 'FormationIQ',
    tagline: 'A central work hub for revenue teams.',
    blurb: "An app concept for a revenue-intelligence overlay on Salesforce — giving AEs, AMs, and CSMs a single starting point for the day with priorities, AI recommendations, and account intelligence pulled in from tools like Clay and 6sense.",
    bullets: [
      'Connect your CRM, get AI-driven recommendations',
      'Role-based cockpits for AE, AM, and CSM',
      'Account intelligence from Clay and 6sense',
    ],
    url: 'https://formationiq.pikesquare.co/',
    label: 'Example app — from our practice',
    gallery: [
      { src: '/showcase/formationiq-hub.png',         caption: 'Sales Leadership Command Center — AI-prioritized actions, pipeline forecast, and rep performance at a glance.' },
      { src: '/showcase/formationiq-account.png',     caption: 'Account 360 — company profile, technology stack, intent signals, and active buying signals from Clay and 6sense.' },
      { src: '/showcase/formationiq-opportunity.png', caption: 'Opportunity detail with AI Deal Summary, MEDDPICC qualification, and Command of the Message.' },
    ],
  },
];

// Other apps we've built beyond the GTM tools above — lighter treatment.
// Drop logos at /showcase/<name>-logo.png and (optional) screenshots at
// /showcase/<name>-screen.png, then fill in `logo` / `image` / `url` below.
type Project = {
  name: string;
  tagline: string;
  role?: string;
  logo?: string;
  image?: string;
  url?: string;
};

const moreProjects: Project[] = [
  {
    name: 'Uncorkd',
    tagline: "A social app for wine lovers to track, rate, and share what they're drinking.",
    role: 'Full app development, beta launch, and commercial model development.',
    logo: '/showcase/uncorkd-logo.png',
    url: 'https://www.uncorkdwine.app/',
  },
  {
    name: 'Keepswell',
    tagline: 'An SMS-first social journaling solution with a companion app — capture moments and share life with the people you love.',
    role: 'A personal hobby project.',
    logo: '/showcase/keepswell-logo.png',
    url: 'https://keepswell.com/',
  },
  {
    name: 'HomeHero',
    tagline: 'A home and chores management app — chores made easier.',
    role: 'Client project — supporting web and iOS app development.',
    logo: '/showcase/homehero-logo.png',
  },
];
---

<BaseLayout title="Showcase — PikeSquare">
  <!-- Hero -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-4xl px-6 pb-16 pt-20">
      <h1 class="font-display text-4xl font-bold tracking-tight text-deep md:text-5xl">
        Selected work.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        A sample of what we've built — custom apps and websites, plus specific sales and CS tools — from our own practice. We can build similar for you, or train your team to build their own.
      </p>
    </div>
  </section>

  <!-- Apps -->
  <section class="border-b border-ink/10 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-8 md:grid-cols-2 md:grid-rows-[auto_auto]">
        {
          apps.map((app) => (
            <div class="flex flex-col gap-8 md:grid md:row-span-2 md:grid-rows-subgrid">
              <article class="flex flex-col rounded-2xl border border-ink/10 bg-bg p-8">
                <h2 class="font-display text-2xl font-bold text-deep">{app.name}</h2>
                <p class="mt-2 text-lg font-semibold text-ink">{app.tagline}</p>
                <p class="mt-4 text-base leading-relaxed text-muted">{app.blurb}</p>
                {app.bullets.length > 0 && (
                  <ul class="mt-6 space-y-2">
                    {app.bullets.map((b) => (
                      <li class="flex gap-3 text-sm text-ink">
                        <span aria-hidden="true" class="mt-1 inline-block h-2 w-2 flex-none bg-accent flex-shrink-0" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
              {app.gallery && app.gallery.length > 0 && (
                <div class="grid gap-4">
                  {app.gallery.map((img) => (
                    <figure class="rounded-2xl border border-ink/10 overflow-hidden bg-white">
                      <img
                        src={img.src}
                        alt={img.caption}
                        class="w-full h-auto"
                        loading="lazy"
                      />
                      <figcaption class="p-4 text-sm text-muted">{img.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- More apps -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">More from our studio</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-deep">
        Other apps we've built.
      </h2>
      <p class="mt-4 max-w-2xl text-base text-muted">
        Beyond GTM, we ship real, working apps fast — across consumer, social, and client work.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          moreProjects.map((p) => (
            <article class="flex flex-col rounded-2xl border border-ink/10 bg-bg p-6">
              {p.logo ? (
                <div class="flex h-28 items-center justify-center rounded-xl border border-ink/10 bg-white p-6">
                  <img src={p.logo} alt={`${p.name} logo`} class="max-h-full max-w-full object-contain" loading="lazy" />
                </div>
              ) : (
                <h3 class="font-display text-xl font-bold text-deep">{p.name}</h3>
              )}
              {p.image && (
                <img
                  src={p.image}
                  alt={`${p.name} screenshot`}
                  class="mt-4 w-full rounded-lg border border-ink/10"
                  loading="lazy"
                />
              )}
              <p class="mt-4 text-base text-ink">{p.tagline}</p>
              {p.role && (
                <p class="mt-3 text-sm text-muted">
                  <span class="font-semibold text-deep">What we did:</span> {p.role}
                </p>
              )}
              {p.url && (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 text-sm font-semibold text-deep underline-offset-4 hover:underline"
                >
                  Visit →
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight text-deep md:text-4xl">
        Need custom tools for your team?
      </h2>
      <p class="mt-4 text-muted">
        We can build them, train your team to build them, or help you figure out what you need. Let's talk.
      </p>
      <div class="mt-8 flex justify-center">
        <CTAButton />
      </div>
    </div>
  </section>
</BaseLayout>

