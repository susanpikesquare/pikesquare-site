---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Insights — PikeSquare">
  <!-- Hero -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-4xl px-6 pb-16 pt-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Insights</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-deep md:text-5xl">
        Notes from the GTM bench.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Articles and field notes on building and scaling go-to-market — including the pieces we publish on LinkedIn.
      </p>
    </div>
  </section>

  <!-- Article list -->
  <section class="border-b border-ink/10 bg-white">
    <div class="mx-auto max-w-4xl px-6 py-16">
      {
        articles.length === 0 ? (
          <p class="text-muted">No articles yet — check back soon.</p>
        ) : (
          <div class="space-y-6">
            {articles.map((a) => (
              <a
                href={`/insights/${a.id}`}
                class="group flex flex-col rounded-2xl border border-ink/10 bg-bg p-7 transition hover:border-deep/40 hover:shadow-md"
              >
                <p class="text-xs font-semibold uppercase tracking-wider text-muted">
                  {fmtDate(a.data.publishedDate)}
                </p>
                <h2 class="mt-2 font-display text-xl font-bold text-deep group-hover:text-accent">
                  {a.data.title}
                </h2>
                <p class="mt-2 text-base text-muted">{a.data.description}</p>
                <span class="mt-4 text-sm font-semibold text-deep group-hover:underline">
                  Read the article →
                </span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
