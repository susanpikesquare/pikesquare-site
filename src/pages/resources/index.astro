---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import { resources, getAllFunctions, getResourcesByFunction, searchResources } from '../../lib/resources-data';
import { SCHEDULING_URL } from '../../lib/site';

const allFunctions = getAllFunctions();
const resourcesJson = JSON.stringify(resources);
const functionsJson = JSON.stringify(allFunctions);
---

<BaseLayout title="Resources — PikeSquare">
  <!-- Hero -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-4xl px-6 pb-16 pt-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Resources</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-deep md:text-5xl">
        Templates, guides, and frameworks.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Free resources to help you think through GTM challenges and implement solutions. Start with a template, adapt it to your context.
      </p>
    </div>
  </section>

  <!-- Search & Filter -->
  <section class="border-b border-ink/10 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <!-- Search Bar -->
      <div class="mb-8">
        <input
          id="search-input"
          type="text"
          placeholder="Search templates, guides, frameworks..."
          class="w-full rounded-full border border-ink/15 bg-white px-6 py-3 text-base text-deep placeholder-muted focus:border-deep focus:outline-none focus:ring-2 focus:ring-deep/10"
        />
      </div>

      <!-- Function Filter Buttons -->
      <div class="flex flex-wrap gap-3">
        <button
          data-filter="all"
          class="filter-btn active rounded-full border-2 border-deep bg-deep px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent hover:border-accent"
        >
          All Resources
        </button>
        {
          allFunctions.map((func) => (
            <button
              data-filter={func}
              class="filter-btn rounded-full border-2 border-ink/20 bg-transparent px-4 py-2 text-sm font-semibold text-deep transition hover:border-deep hover:bg-bg"
            >
              {func}
            </button>
          ))
        }
      </div>

      <!-- Clear filters button (hidden by default) -->
      <button
        id="clear-filters"
        class="hidden mt-4 text-sm font-semibold text-muted underline-offset-4 hover:text-deep hover:underline"
      >
        Clear filters and search
      </button>
    </div>
  </section>

  <!-- Results -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <!-- No results message -->
      <div id="no-results" class="hidden rounded-2xl border border-ink/10 bg-bg p-8 text-center">
        <p class="text-lg text-muted">
          No resources found. Try adjusting your search or filters.
        </p>
      </div>

      <!-- Results by function -->
      <div id="results-container" class="space-y-12">
        <!-- JS will populate this -->
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section>
    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight text-deep md:text-4xl">
        Looking for something specific?
      </h2>
      <p class="mt-4 text-lg text-muted">
        Let's talk about what you need. We can build custom templates for your team or help you adapt these to your context.
      </p>
      <div class="mt-8 flex justify-center">
        <CTAButton />
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ resourcesJson, functionsJson }}>
  const allResources = JSON.parse(resourcesJson);
  const allFunctions = JSON.parse(functionsJson);

  const searchInput = document.getElementById('search-input');
  const filterButtons = document.querySelectorAll('.filter-btn');
  const resultsContainer = document.getElementById('results-container');
  const noResultsMsg = document.getElementById('no-results');
  const clearBtn = document.getElementById('clear-filters');

  let currentFilter = 'all';
  let currentSearch = '';

  function renderResults() {
    const filtered = filterAndSearch(allResources, currentFilter, currentSearch);

    if (filtered.length === 0) {
      resultsContainer.innerHTML = '';
      noResultsMsg.classList.remove('hidden');
      clearBtn.classList.add('hidden');
      return;
    }

    noResultsMsg.classList.add('hidden');

    // Group by function for display
    const grouped = {};
    filtered.forEach(resource => {
      resource.functions.forEach(func => {
        if (!grouped[func]) grouped[func] = [];
        grouped[func].push(resource);
      });
    });

    // Render grouped results
    let html = '';
    Object.keys(grouped)
      .sort()
      .forEach(func => {
        html += `
          <div>
            <h3 class="font-display text-2xl font-bold text-deep mb-6">${func}</h3>
            <div class="grid gap-6 md:grid-cols-2">
              ${grouped[func]
                .map(
                  r => `
                <article class="flex flex-col rounded-2xl border border-ink/10 bg-white p-7 transition hover:border-deep/40 hover:shadow-md">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1">
                      <h4 class="font-display text-lg font-bold text-deep">${r.title}</h4>
                      <p class="mt-2 text-sm text-muted">${r.description}</p>
                    </div>
                    <span class="mt-1 inline-flex flex-shrink-0 rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
                      ${r.type}
                    </span>
                  </div>
                  <div class="mt-4 pt-4 border-t border-ink/10">
                    ${
                      r.driveLink
                        ? `<a href="${r.driveLink}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-deep underline-offset-4 hover:underline">
                            Download PDF →
                          </a>`
                        : r.externalLink
                          ? `<a href="${r.externalLink}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-deep underline-offset-4 hover:underline">
                              Open →
                            </a>`
                          : ''
                    }
                  </div>
                </article>
              `
                )
                .join('')}
            </div>
          </div>
        `;
      });

    resultsContainer.innerHTML = html;

    // Show clear button if search or non-default filter is active
    if (currentSearch || currentFilter !== 'all') {
      clearBtn.classList.remove('hidden');
    } else {
      clearBtn.classList.add('hidden');
    }
  }

  function filterAndSearch(items, filter, search) {
    let result = items;

    // Apply function filter
    if (filter !== 'all') {
      result = result.filter(r => r.functions.includes(filter));
    }

    // Apply search
    if (search) {
      const q = search.toLowerCase();
      result = result.filter(
        r =>
          r.title.toLowerCase().includes(q) ||
          r.description.toLowerCase().includes(q) ||
          r.tags.some(tag => tag.toLowerCase().includes(q))
      );
    }

    return result;
  }

  // Event listeners
  searchInput.addEventListener('input', e => {
    currentSearch = e.target.value;
    renderResults();
  });

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state
      filterButtons.forEach(b => {
        b.classList.remove('border-deep', 'bg-deep', 'text-white');
        b.classList.add('border-ink/20', 'bg-transparent', 'text-deep');
      });
      btn.classList.add('border-deep', 'bg-deep', 'text-white');
      btn.classList.remove('border-ink/20', 'bg-transparent', 'text-deep');

      currentFilter = btn.dataset.filter;
      renderResults();
    });
  });

  clearBtn.addEventListener('click', () => {
    currentSearch = '';
    currentFilter = 'all';
    searchInput.value = '';

    // Reset button states
    filterButtons.forEach(b => {
      b.classList.remove('border-deep', 'bg-deep', 'text-white');
      b.classList.add('border-ink/20', 'bg-transparent', 'text-deep');
    });
    filterButtons[0].classList.add('border-deep', 'bg-deep', 'text-white');
    filterButtons[0].classList.remove('border-ink/20', 'bg-transparent', 'text-deep');

    renderResults();
  });

  // Initial render
  renderResults();
</script>
