---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SCHEDULING_URL } from '../lib/site';

// Visual brand guide. Source of truth lives in BRAND.md at repo root; this
// page renders the swatches, type, logo, and components so designers and
// vendors can see the brand in use.

type Swatch = { name: string; hex: string; cls: string; text: string; role: string };

const primary: Swatch[] = [
  { name: 'Deep',   hex: '#202971', cls: 'bg-deep',   text: 'text-white', role: 'Primary navy. Wordmark, headlines, primary buttons.' },
  { name: 'Accent', hex: '#FF8001', cls: 'bg-accent', text: 'text-white', role: 'Primary orange. Mark, hover states, callouts, emphasis.' },
  { name: 'Ink',    hex: '#210D10', cls: 'bg-ink',    text: 'text-white', role: 'Near-black body text.' },
  { name: 'BG',     hex: '#fafaf7', cls: 'bg-bg',     text: 'text-ink',   role: 'Warm off-white. Default page background.' },
];

const supporting: Swatch[] = [
  { name: 'Muted',       hex: '#594E86', cls: 'bg-muted',       text: 'text-white', role: 'Secondary body text, captions.' },
  { name: 'Deep soft',   hex: '#A7ABC7', cls: 'bg-deep-soft',   text: 'text-ink',   role: 'Tinted backgrounds, soft chips.' },
  { name: 'Accent soft', hex: '#FFBB8A', cls: 'bg-accent-soft', text: 'text-ink',   role: 'Soft callouts, illustrative accents.' },
  { name: 'Muted soft',  hex: '#938CB1', cls: 'bg-muted-soft',  text: 'text-ink',   role: 'Tertiary text, placeholders.' },
];

const editorial: Swatch[] = [
  { name: 'Rust', hex: '#802101', cls: 'bg-rust', text: 'text-white', role: 'Editorial / data viz only.' },
  { name: 'Sun',  hex: '#FFDB01', cls: 'bg-sun',  text: 'text-ink',   role: 'Editorial / data viz only.' },
  { name: 'Sea',  hex: '#3F94B2', cls: 'bg-sea',  text: 'text-white', role: 'Editorial / data viz only.' },
];

const weights = [
  { w: 400, label: 'Regular',    use: 'Body' },
  { w: 500, label: 'Medium',     use: 'UI labels, captions' },
  { w: 600, label: 'Semibold',   use: 'Buttons, emphasis' },
  { w: 700, label: 'Bold',       use: 'Section headings' },
  { w: 800, label: 'Extrabold',  use: 'Page headlines' },
];
---

<BaseLayout title="Brand — PikeSquare">
  <!-- Hero -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-4xl px-6 pb-16 pt-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Brand</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-deep md:text-5xl">
        The PikeSquare brand guide.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        How we look, how we sound, and how we show up. The visual reference for the brand —
        full written guide lives in
        <code class="rounded bg-deep-soft/40 px-1.5 py-0.5 font-mono text-sm text-deep">BRAND.md</code>
        at the repo root.
      </p>
    </div>
  </section>

  <!-- Voice -->
  <section class="border-b border-ink/10 bg-white">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Voice</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-deep">
        Like a senior operator who's been there.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        Confident, direct, plain-spoken. Not a brochure. We take positions, use plain English,
        keep sentences short, and lean on the em dash. We're talking to a smart CEO over coffee —
        not pitching her.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-ink/10 bg-bg p-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-deep">Do</p>
          <ul class="mt-4 space-y-2 text-sm text-ink">
            <li>Lead with a point of view. Take a position.</li>
            <li>Use plain English. "Helps you close more deals," not "drives revenue acceleration."</li>
            <li>Keep sentences short. Em dashes are a feature.</li>
            <li>Write the way you'd talk to a smart CEO over coffee.</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-bg p-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-rust">Don't</p>
          <ul class="mt-4 space-y-2 text-sm text-ink">
            <li>Pile on adjectives. "World-class, best-in-breed, enterprise-grade" — pick one or none.</li>
            <li>Hedge. ("It can sometimes be the case that…")</li>
            <li>Use buzzwords without a concrete claim behind them.</li>
            <li>Default to passive voice.</li>
          </ul>
        </div>
      </div>
      <div class="mt-10 rounded-2xl border border-deep/15 bg-deep/[0.03] p-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-deep">Voice samples</p>
        <ul class="mt-4 space-y-3 text-base text-ink">
          <li>"Senior GTM operators for startups and scale-ups."</li>
          <li>"Selling on bettER, fastER, cheapER gets disruptive tech stuck against incumbents."</li>
          <li>"Price is your fair share of the value you create."</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Logo -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Logo</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-deep">Marks.</h2>
      <p class="mt-4 max-w-2xl text-base text-muted">
        Use the primary wordmark by default. Use the square lockup for avatars and app tiles.
        Use the icon alone only when the wordmark won't fit. Files live in
        <code class="rounded bg-deep-soft/40 px-1.5 py-0.5 font-mono text-sm text-deep">public/brand/</code>.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <figure class="rounded-2xl border border-ink/10 bg-bg p-6">
          <div class="flex h-32 items-center justify-center rounded-xl border border-ink/10 bg-white p-6">
            <img src="/brand/logo.png" alt="Primary wordmark" class="max-h-full max-w-full object-contain" />
          </div>
          <figcaption class="mt-4">
            <p class="font-semibold text-deep">Primary wordmark</p>
            <p class="mt-1 text-sm text-muted"><code class="font-mono text-xs">/brand/logo.png</code></p>
          </figcaption>
        </figure>
        <figure class="rounded-2xl border border-ink/10 bg-bg p-6">
          <div class="flex h-32 items-center justify-center rounded-xl border border-ink/10 bg-white p-6">
            <img src="/brand/logo-square.png" alt="Square lockup" class="max-h-full max-w-full object-contain" />
          </div>
          <figcaption class="mt-4">
            <p class="font-semibold text-deep">Square lockup</p>
            <p class="mt-1 text-sm text-muted"><code class="font-mono text-xs">/brand/logo-square.png</code></p>
          </figcaption>
        </figure>
        <figure class="rounded-2xl border border-ink/10 bg-bg p-6">
          <div class="flex h-32 items-center justify-center rounded-xl border border-ink/10 bg-white p-6">
            <img src="/brand/icon.png" alt="Icon" class="max-h-16 w-auto object-contain" />
          </div>
          <figcaption class="mt-4">
            <p class="font-semibold text-deep">Icon</p>
            <p class="mt-1 text-sm text-muted"><code class="font-mono text-xs">/brand/icon.png</code></p>
          </figcaption>
        </figure>
      </div>
      <p class="mt-6 text-sm text-muted">
        <span class="font-semibold text-deep">Don't:</span> recolor the wordmark, stretch it, add drop shadows,
        or place it on busy photos. Give it clear space — at least the height of the "P" on all sides.
      </p>
    </div>
  </section>

  <!-- Color -->
  <section class="border-b border-ink/10 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Color</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-deep">Palette.</h2>
      <p class="mt-4 max-w-2xl text-base text-muted">
        Deep + Accent is the brand. Everything else is supporting. Rust, Sun, and Sea are for
        editorial illustrations and data viz only — never primary UI.
      </p>

      <h3 class="mt-12 font-display text-xl font-bold text-deep">Primary</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {primary.map((s) => (
          <div class={`rounded-2xl border border-ink/10 ${s.cls}`}>
            <div class={`flex h-32 items-end p-5 ${s.text}`}>
              <div>
                <p class="font-display text-lg font-bold">{s.name}</p>
                <p class="mt-1 font-mono text-xs uppercase opacity-80">{s.hex}</p>
              </div>
            </div>
            <div class="rounded-b-2xl bg-bg p-4 text-sm text-muted">{s.role}</div>
          </div>
        ))}
      </div>

      <h3 class="mt-12 font-display text-xl font-bold text-deep">Supporting</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {supporting.map((s) => (
          <div class={`rounded-2xl border border-ink/10 ${s.cls}`}>
            <div class={`flex h-24 items-end p-5 ${s.text}`}>
              <div>
                <p class="font-display text-base font-bold">{s.name}</p>
                <p class="mt-1 font-mono text-xs uppercase opacity-80">{s.hex}</p>
              </div>
            </div>
            <div class="rounded-b-2xl bg-bg p-4 text-sm text-muted">{s.role}</div>
          </div>
        ))}
      </div>

      <h3 class="mt-12 font-display text-xl font-bold text-deep">Editorial / data viz</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {editorial.map((s) => (
          <div class={`rounded-2xl border border-ink/10 ${s.cls}`}>
            <div class={`flex h-24 items-end p-5 ${s.text}`}>
              <div>
                <p class="font-display text-base font-bold">{s.name}</p>
                <p class="mt-1 font-mono text-xs uppercase opacity-80">{s.hex}</p>
              </div>
            </div>
            <div class="rounded-b-2xl bg-bg p-4 text-sm text-muted">{s.role}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Typography -->
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Type</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-deep">Inter — that's it.</h2>
      <p class="mt-4 max-w-2xl text-base text-muted">
        One typeface across the whole brand. We use Inter for both display and body, with weights
        from regular (400) to extrabold (800).
      </p>

      <div class="mt-12 space-y-8">
        <div>
          <p class="text-xs uppercase tracking-wider text-accent">H1 — hero headline</p>
          <p class="mt-2 font-display text-4xl font-bold tracking-tight text-deep md:text-6xl md:leading-[1.05]">
            Senior GTM operators for startups and scale-ups.
          </p>
          <p class="mt-2 font-mono text-xs text-muted">text-4xl md:text-6xl · font-bold · tracking-tight · text-deep</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-accent">H2 — section heading</p>
          <p class="mt-2 font-display text-3xl font-bold tracking-tight text-deep">
            What we actually do.
          </p>
          <p class="mt-2 font-mono text-xs text-muted">text-3xl · font-bold · tracking-tight · text-deep</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-accent">H3 — sub-section</p>
          <p class="mt-2 font-display text-xl font-bold text-deep md:text-2xl">
            The work that lives behind the deck.
          </p>
          <p class="mt-2 font-mono text-xs text-muted">text-xl md:text-2xl · font-bold · text-deep</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-accent">Body lead</p>
          <p class="mt-2 text-lg text-muted md:text-xl">
            Plain language. Real sentences. The way you'd say it out loud to a CEO who values
            your time.
          </p>
          <p class="mt-2 font-mono text-xs text-muted">text-lg md:text-xl · text-muted</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-accent">Body</p>
          <p class="mt-2 max-w-2xl text-base leading-relaxed text-ink">
            Default body copy. Used for article text, descriptions, anywhere you're asking the
            reader to spend more than a glance. Comfortable line height, near-black ink on warm
            off-white background.
          </p>
          <p class="mt-2 font-mono text-xs text-muted">text-base · leading-relaxed · text-ink</p>
        </div>
      </div>

      <h3 class="mt-16 font-display text-xl font-bold text-deep">Weights in use</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {weights.map((w) => (
          <div class="rounded-2xl border border-ink/10 bg-bg p-5">
            <p class={`font-display text-3xl text-deep`} style={`font-weight:${w.w}`}>Ag</p>
            <p class="mt-3 text-sm font-semibold text-deep">{w.w} · {w.label}</p>
            <p class="mt-1 text-xs text-muted">{w.use}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Components -->
  <section class="border-b border-ink/10 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Components</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-deep">UI patterns.</h2>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-deep">Primary CTA</p>
          <div class="mt-3 flex items-center gap-4 rounded-2xl border border-ink/10 bg-bg p-6">
            <a href={SCHEDULING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-deep px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-accent">
              Book a meeting
            </a>
            <span class="text-sm text-muted">Hover turns orange.</span>
          </div>
          <p class="mt-2 font-mono text-xs text-muted">rounded-full · bg-deep → hover:bg-accent</p>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-deep">Eyebrow</p>
          <div class="mt-3 rounded-2xl border border-ink/10 bg-bg p-6">
            <p class="text-sm font-semibold uppercase tracking-wider text-accent">Resources</p>
            <h3 class="mt-2 font-display text-2xl font-bold text-deep">Section title.</h3>
          </div>
          <p class="mt-2 font-mono text-xs text-muted">text-sm · uppercase · tracking-wider · text-accent</p>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-deep">Card</p>
          <div class="mt-3">
            <article class="rounded-2xl border border-ink/10 bg-bg p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-accent">Article</p>
              <h3 class="mt-3 font-display text-xl font-bold text-deep">In Defense of CAC/LTV</h3>
              <p class="mt-2 text-sm text-muted">CAC/LTV is messy, hard to calculate, and indispensable.</p>
            </article>
          </div>
          <p class="mt-2 font-mono text-xs text-muted">rounded-2xl · border-ink/10 · bg-bg</p>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-deep">Bullet list</p>
          <div class="mt-3 rounded-2xl border border-ink/10 bg-bg p-6">
            <ul class="space-y-2 text-sm text-ink">
              <li class="flex gap-3"><span aria-hidden="true" class="mt-1 inline-block h-2 w-2 flex-none bg-accent"></span><span>Square orange bullet — the brand mark in miniature.</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="mt-1 inline-block h-2 w-2 flex-none bg-accent"></span><span>2×2 px square, mt-1 to align with first line.</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="mt-1 inline-block h-2 w-2 flex-none bg-accent"></span><span>Tight gap, comfortable line height.</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Email signature + footer -->
  <section>
    <div class="mx-auto max-w-4xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Email signature</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-deep">Plain, no banner image.</h2>
      <pre class="mt-6 overflow-x-auto rounded-2xl border border-ink/10 bg-bg p-6 font-mono text-sm text-ink leading-relaxed">Susan McGovern Bamberger
Co-founder · PikeSquare
info@pikesquare.co · pikesquare.co
Book a meeting: https://cal.com/pikesquare/30min</pre>

      <div class="mt-16 rounded-2xl border border-deep/15 bg-deep/[0.03] p-6">
        <p class="text-sm text-muted">
          Source of truth for this guide:
          <code class="rounded bg-deep-soft/40 px-1.5 py-0.5 font-mono text-xs text-deep">BRAND.md</code>
          at the repo root, plus
          <code class="rounded bg-deep-soft/40 px-1.5 py-0.5 font-mono text-xs text-deep">src/styles/globals.css</code>
          for color and font tokens. Update both together when the brand evolves.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
